{
  "name": "kingspan-purchase-requests-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:e2e": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "cy:open": "node cypress/run.mjs open --e2e",
    "cy:run": "node cypress/run.mjs run --e2e",
    "test:e2e": "node cypress/e2e-runner.mjs",
    "test:e2e:api": "node cypress/run.mjs run --config-file cypress.api.config.ts",
    "typecheck:e2e": "tsc --noEmit -p cypress",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@tanstack/react-query": "^5.59.0",
    "antd": "^5.21.0",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "cypress": "^13.17.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.8"
  }
}
