# The backend is resolved per request (variable + resolver), NOT once at startup: the SPA must start and stay
# healthy even when the backend is not up yet or not there at all (in docker compose the gateway serves /api).
# NGINX_LOCAL_RESOLVERS = this container's DNS servers, exported by the image entrypoint
# (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 in the Dockerfile).
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # same rewrite as vite.config.ts: /api/x -> ${BACKEND_URL}/x
    location /api/ {
        set $backend_upstream ${BACKEND_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # hashed assets can be cached forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA routing: unknown paths fall back to index.html
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
