# Copy to .env and adjust. Never commit the real .env.

# ---- backend (Spring Boot, ./backend) ----
DB_URL=jdbc:postgresql://localhost:5432/purchase
DB_USER=purchase
DB_PASSWORD=change-me
# HS256 signing key: random, at least 32 bytes. Generate one with: openssl rand -base64 48
# Left empty on purpose — the backend refuses to start without it, or with a documented placeholder (SEC-F13).
JWT_SECRET=
JWT_ISSUER=purchase-requests
JWT_AUDIENCE=purchase-requests-api
JWT_TTL=PT15M
PORT=3000
# Creates the README §5.4 demo data on first start (skipped when it already exists).
# The demo users share a publicly documented password — set false for anything but a local demo (SEC-F11).
SEED_ENABLED=true
# Abuse limits (docs/security/FINDINGS.md SEC-F01, SEC-F03)
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_CLIENT=50
LOGIN_THROTTLE_WINDOW=PT15M
MAX_REQUEST_BODY=1MB
# Swagger UI at /docs and the OpenAPI JSON (README §3.1); false hides them in production
API_DOCS_ENABLED=true

# ---- frontend (Vite, ./frontend) ----
# Build-time flags (SEC-F04). Unset = mock backend and demo-login picker ON for the dev server, OFF for a
# production build. true = force on; false = force off (real API through the /api proxy → http://localhost:3000).
# VITE_MOCK_BACKEND=
# A demo deployment against a seeded backend may show the demo-user picker:
# VITE_DEMO_LOGIN=

# ---- docker compose (./docker-compose.yml) ----
# Host ports. The database is published on 127.0.0.1 only. JWT_SECRET above may stay empty with compose:
# a random one is generated on first start and kept in the "jwt-secret" volume.
FRONTEND_PORT=8080
BACKEND_PORT=3000
DB_PORT=5432
